top_artists_total = df.groupby('artist name')['total'].sum().sort_values(ascending=False).head(5)
plt.figure()
plt.bar(top_artists_total.index, top_artists_total.values, color='skyblue')
plt.title('Top 5 Artists by Total Streams')
plt.xlabel('Artist')
plt.ylabel('Streams')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.show()

plt.figure()
plt.pie(top_artists_total.values, labels=top_artists_total.index, autopct='%1.1f%%')
plt.title('Top 5 Artists Total Stream Share')
