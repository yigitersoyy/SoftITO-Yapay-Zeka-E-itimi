cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)
cv_results = {}
for name, clf in classifiers.items():
    scores = cross_val_score(clf, Xc_train, yc_train, cv=cv, scoring="accuracy")
    cv_results[name] = {"CV Ortalama Accuracy": scores.mean(), "Standart Sapma": scores.std()}

print("\n--- 5-Katlı Çapraz Doğrulama Sonuçları ---")
display(pd.DataFrame(cv_results).T)

