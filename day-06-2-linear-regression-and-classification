for name, clf in classifiers.items():
    if hasattr(clf, "predict_proba"):
        probs = clf.predict_proba(Xc_test)[:, 1]
    else:
        probs = clf.predict(Xc_test)
    fpr, tpr, _ = roc_curve(yc_test, probs)
    roc_auc = auc(fpr, tpr)
    axes[1].plot(fpr, tpr, label=f"{name} (AUC = {roc_auc:.2f})")

axes[1].plot([0, 1], [0, 1], "k--")
axes[1].set_title("ROC-AUC Eğrisi Karşılaştırması")
axes[1].set_xlabel("Yanlış Pozitif Oranı (FPR)")
