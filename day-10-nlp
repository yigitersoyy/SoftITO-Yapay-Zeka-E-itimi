from tensorflow.keras.datasets import imdb
from tensorflow.keras.preprocessing.sequence import pad_sequences

VOCAB_SIZE = 10000
MAX_LEN = 200
EMBED_DIM = 64
LSTM_UNITS = 64

(X_train_text, y_train_text), (X_test_text, y_test_text) = imdb.load_data(num_words=VOCAB_SIZE)

word_index = imdb.get_word_index()
inverted_word_index = {value + 3: key for key, value in word_index.items()}
inverted_word_index[0] = "<PAD>"
inverted_word_index[1] = "<START>"
inverted_word_index[2] = "<UNK>"
inverted_word_index[3] = "<UNUSED>"

def decode_review(encoded_seq):
    return " ".join([inverted_word_index.get(i, "?") for i in encoded_seq])

print(decode_review(X_train_text[0]))
print(f"Etiket: {y_train_text[0]}")

X_train_pad = pad_sequences(X_train_text, maxlen=MAX_LEN, padding='post', truncating='post')
X_test_pad = pad_sequences(X_test_text, maxlen=MAX_LEN, padding='post', truncating='post')

nlp_model = models.Sequential([
    layers.Embedding(input_dim=VOCAB_SIZE, output_dim=EMBED_DIM, input_length=MAX_LEN),
    layers.LSTM(LSTM_UNITS),
    layers.Dropout(0.3),
    layers.Dense(1, activation='sigmoid')
])

nlp_early_stop = callbacks.EarlyStopping(
    monitor='val_loss',
    patience=3,
    restore_best_weights=True
)

nlp_model.compile(
    optimizer='adam',
    loss='binary_crossentropy',
    metrics=['accuracy']
)

nlp_model.summary()

nlp_model.fit(
    X_train_pad,
    y_train_text,
    epochs=5,
    batch_size=64,
    validation_split=0.2,
    callbacks=[nlp_early_stop]
)

def encode_and_predict(text, word_idx_map, model, max_length):
    tokens = text.lower().replace(".", "").replace(",", "").split()
    sequence = [1]
    for token in tokens:
        idx = word_idx_map.get(token, 2)
        if idx < VOCAB_SIZE:
            sequence.append(idx + 3)
        else:
            sequence.append(2)
    padded = pad_sequences([sequence], maxlen=max_length, padding='post', truncating='post')
    prediction = model.predict(padded)[0][0]
    return prediction, 1 if prediction >= 0.5 else 0

sample_review = "this movie was fantastic brilliant acting and wonderful script"
pred_score, pred_label = encode_and_predict(sample_review, word_index, nlp_model, MAX_LEN)
print(f"Metin: {sample_review}")
print(f"Skor: {pred_score:.4f} | Tahmin Edilen Sınıf: {pred_label}")







import matplotlib.pyplot as plt
import seaborn as sns
from tensorflow.keras.datasets import fashion_mnist

LEARNING_RATE = 0.001
EPOCHS = 10
BATCH_SIZE = 64
VALIDATION_SPLIT = 0.2
DATASET_NAME = "fashion_mnist"

RESULTS_DIR = "./results"
os.makedirs(RESULTS_DIR, exist_ok=True)

CLASS_NAMES = {
    0: "T-shirt/top",
    1: "Trouser",
    2: "Pullover",
    3: "Dress",
    4: "Coat",
    5: "Sandal",
    6: "Shirt",
    7: "Sneaker",
    8: "Bag",
    9: "Ankle boot"
}

def load_data():
    (x_train_raw, y_train_raw), (x_test_raw, y_test_raw) = fashion_mnist.load_data()
    x_train_raw = np.expand_dims(x_train_raw, -1).astype("float32")
    x_test_raw = np.expand_dims(x_test_raw, -1).astype("float32")

    x_train_split, x_val_split, y_train_split, y_val_split = train_test_split(
        x_train_raw, y_train_raw, test_size=VALIDATION_SPLIT, random_state=SEED, stratify=y_train_raw
    )

    train_ds = tf.data.Dataset.from_tensor_slices((x_train_split, y_train_split))
    train_ds = train_ds.shuffle(10000).batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)

    val_ds = tf.data.Dataset.from_tensor_slices((x_val_split, y_val_split))
    val_ds = val_ds.batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)

    test_ds = tf.data.Dataset.from_tensor_slices((x_test_raw, y_test_raw))
    test_ds = test_ds.batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)

    return train_ds, val_ds, test_ds, x_test_raw, y_test_raw

train_dataset_cnn, val_dataset_cnn, test_dataset_cnn, x_test_img, y_test_img = load_data()

def conv_block(filters):
    return models.Sequential([
        layers.Conv2D(filters, (3, 3), padding='same'),
        layers.BatchNormalization(),
        layers.Activation('relu'),
        layers.MaxPooling2D((2, 2))
    ])

def build_cnn_model():
    data_augmentation = models.Sequential([
        layers.RandomFlip("horizontal"),
        layers.RandomRotation(0.05),
        layers.RandomZoom(0.05)
    ])

    inputs = layers.Input(shape=(28, 28, 1))
    x = data_augmentation(inputs)
    x = layers.Rescaling(1.0 / 255.0)(x)
    x = conv_block(32)(x)
    x = conv_block(64)(x)
    x = layers.Flatten()(x)
    x = layers.Dense(128, activation='relu')(x)
    x = layers.Dropout(0.4)(x)
    outputs = layers.Dense(10, activation='softmax')(x)

    cnn = models.Model(inputs=inputs, outputs=outputs)
    optimizer = tf.keras.optimizers.Adam(learning_rate=LEARNING_RATE)
    cnn.compile(
        optimizer=optimizer,
        loss='sparse_categorical_crossentropy',
        metrics=['accuracy']
    )
    return cnn

cnn_model = build_cnn_model()
cnn_model.summary()

history = cnn_model.fit(
    train_dataset_cnn,
    validation_data=val_dataset_cnn,
    epochs=EPOCHS
)

def plot_history(hist, save_dir):
    fig, axes = plt.subplots(1, 2, figsize=(14, 5))
    
    axes[0].plot(hist.history['loss'], label='Eğitim Kaybı')
    axes[0].plot(hist.history['val_loss'], label='Doğrulama Kaybı')
    axes[0].set_title('Kayıp Eğrisi')
    axes[0].set_xlabel('Epoch')
    axes[0].set_ylabel('Loss')
    axes[0].legend()
    
    axes[1].plot(hist.history['accuracy'], label='Eğitim Doğruluğu')
    axes[1].plot(hist.history['val_accuracy'], label='Doğrulama Doğruluğu')
    axes[1].set_title('Doğruluk Eğrisi')
    axes[1].set_xlabel('Epoch')
    axes[1].set_ylabel('Accuracy')
    axes[1].legend()

    plt.tight_layout()
    plt.savefig(os.path.join(save_dir, 'training_curves.png'))
    plt.show()

plot_history(history, RESULTS_DIR)

y_pred_probs = cnn_model.predict(x_test_img)
y_pred_classes = np.argmax(y_pred_probs, axis=1)

cm = confusion_matrix(y_test_img, y_pred_classes)
class_labels = [CLASS_NAMES[i] for i in range(10)]

plt.figure(figsize=(10, 8))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=class_labels, yticklabels=class_labels)
plt.title('Fashion MNIST Test Hata Matrisi')
plt.xlabel('Tahmin Edilen Sınıf')
plt.ylabel('Gerçek Sınıf')
plt.xticks(rotation=45)
plt.tight_layout()
plt.savefig(os.path.join(RESULTS_DIR, 'confusion_matrix.png'))
plt.show()
