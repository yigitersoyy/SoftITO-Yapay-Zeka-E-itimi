*** Telco Customer Churn (IBM) ***

import warnings
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats
import statsmodels.api as sm
from statsmodels.formula.api import ols
from statsmodels.stats.multicomp import pairwise_tukeyhsd
from statsmodels.stats.outliers_influence import variance_inflation_factor
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA

warnings.filterwarnings('ignore')

url = "https://raw.githubusercontent.com/IBM/telco-customer-churn-on-icp4d/master/data/Telco-Customer-Churn.csv"
df = pd.read_csv(url)

df['TotalCharges'] = pd.to_numeric(df['TotalCharges'].str.strip(), errors='coerce')
df.dropna(subset=['TotalCharges'], inplace=True)
df.drop_duplicates(inplace=True)
df.reset_index(drop=True, inplace=True)

summary = pd.DataFrame({
    'Dtype': df.dtypes,
    'N_Unique': df.nunique(),
    'Null_Count': df.isnull().sum(),
    'Null_Ratio': (df.isnull().sum() / len(df)) * 100
})
print(summary.head(8))

num_cols = ['tenure', 'MonthlyCharges', 'TotalCharges']

for col in num_cols:
    s = df[col].dropna()
    mean, sem = np.mean(s), stats.sem(s)
    ci = stats.t.interval(0.95, df=len(s)-1, loc=mean, scale=sem)
    print(f"{col} -> Mean: {mean:.2f}, CI 95%: [{ci[0]:.2f}, {ci[1]:.2f}]")

desc = df[num_cols].describe().T
desc['skew'] = df[num_cols].skew()
desc['kurtosis'] = df[num_cols].kurtosis()
print(desc[['mean', 'std', 'skew', 'kurtosis']])

sample = df[num_cols].sample(n=500, random_state=42)
for col in num_cols:
    print(f"{col} - Shapiro: {stats.shapiro(sample[col])[1]:.5e}, D'Agostino: {stats.normaltest(df[col])[1]:.5e}")

fig, axes = plt.subplots(1, 3, figsize=(12, 3))
for i, col in enumerate(num_cols):
    sm.qqplot(df[col], line='s', ax=axes[i])
    axes[i].set_title(col)
plt.tight_layout()
plt.show()

churn_yes = df[df['Churn'] == 'Yes']['MonthlyCharges']
churn_no = df[df['Churn'] == 'No']['MonthlyCharges']

print("Levene p:", stats.levene(churn_yes, churn_no)[1])
print("Mann-Whitney U p:", stats.mannwhitneyu(churn_yes, churn_no)[1])
print("Welch t-test p:", stats.ttest_ind(churn_yes, churn_no, equal_var=False)[1])

groups = [g['MonthlyCharges'].values for _, g in df.groupby('Contract')]
print("ANOVA p:", stats.f_oneway(*groups)[1])
print("Kruskal-Wallis p:", stats.kruskal(*groups)[1])

anova_model = ols('MonthlyCharges ~ C(Contract)', data=df).fit()
anova_tab = sm.stats.anova_lm(anova_model, typ=2)
eta_sq = anova_tab['sum_sq'].iloc[0] / anova_tab['sum_sq'].sum()
print("Eta-squared:", eta_sq)

tukey = pairwise_tukeyhsd(endog=df['MonthlyCharges'], groups=df['Contract'], alpha=0.05)
print(tukey.summary())

ct = pd.crosstab(df['Contract'], df['Churn'])
chi2, p_val, _, _ = stats.chi2_contingency(ct)
cramers_v = np.sqrt(chi2 / (ct.sum().sum() * (min(ct.shape) - 1)))
print("Chi2 p:", p_val, "Cramer's V:", cramers_v)

corr = df[num_cols].corr()
p_matrix = pd.DataFrame(index=num_cols, columns=num_cols)
for c1 in num_cols:
    for c2 in num_cols:
        p_matrix.loc[c1, c2] = stats.pearsonr(df[c1], df[c2])[1]

fig, ax = plt.subplots(1, 2, figsize=(10, 4))
sns.heatmap(corr, annot=True, cmap='coolwarm', ax=ax[0])
sns.heatmap(corr, annot=True, cmap='coolwarm', mask=(p_matrix.astype(float) >= 0.05), ax=ax[1])
plt.tight_layout()
plt.show()

X = df[num_cols]
X_const = sm.add_constant(X)
vif_no_const = [variance_inflation_factor(X.values, i) for i in range(X.shape[1])]
vif_const = [variance_inflation_factor(X_const.values, i) for i in range(X_const.shape[1])]
print("VIF No Const:", dict(zip(X.columns, vif_no_const)))
print("VIF With Const:", dict(zip(X_const.columns, vif_const)))

ols_fit = ols('TotalCharges ~ tenure + MonthlyCharges', data=df).fit()
print(ols_fit.summary())

X_scaled = StandardScaler().fit_transform(df[num_cols])
pca = PCA(n_components=3).fit(X_scaled)
print("PCA Explained Variance:", pca.explained_variance_ratio_)
print("Cumulative Variance:", np.cumsum(pca.explained_variance_ratio_))

plt.figure(figsize=(5, 3))
plt.plot(range(1, 4), np.cumsum(pca.explained_variance_ratio_), marker='o')
plt.xticks(range(1, 4))
plt.grid(True)
plt.show()
