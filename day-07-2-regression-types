*** Auto MPG ***
*** Polynominal regression ***

import warnings
warnings.filterwarnings('ignore')

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error

df = sns.load_dataset('mpg').dropna().drop(columns=['name'])

X_single = df[['horsepower']]
y_single = df['mpg']
X_tr_s, X_te_s, y_tr_s, y_te_s = train_test_split(X_single, y_single, test_size=0.20, random_state=42)

degrees = [1, 2, 3, 4]
colors = ['gray', 'green', 'blue', 'orange']
x_plot = np.linspace(X_single.min(), X_single.max(), 300).reshape(-1, 1)

plt.figure(figsize=(10, 6))
plt.scatter(X_single, y_single, color='lightgray', alpha=0.6)

for deg, col in zip(degrees, colors):
    poly = PolynomialFeatures(degree=deg, include_bias=False)
    X_tr_poly = poly.fit_transform(X_tr_s)
    X_te_poly = poly.transform(X_te_s)
    
    p_model = LinearRegression()
    p_model.fit(X_tr_poly, y_tr_s)
    preds = p_model.predict(X_te_poly)
    
    score = r2_score(y_te_s, preds)
    rmse = np.sqrt(mean_squared_error(y_te_s, preds))
    print(f"Derece {deg} -> R2: {score:.4f}, RMSE: {rmse:.4f}")
    
    y_plot_pred = p_model.predict(poly.transform(x_plot))
    plt.plot(x_plot, y_plot_pred, color=col, lw=2, label=f"Derece {deg} (R2={score:.2f})")

plt.xlabel('Horsepower')
plt.ylabel('MPG')
plt.legend()
plt.show()

df_encoded = pd.get_dummies(df, columns=['origin'], drop_first=True, dtype=int)
X_all = df_encoded.drop(columns=['mpg'])
y_all = df_encoded['mpg']

X_train, X_test, y_train, y_test = train_test_split(X_all, y_all, test_size=0.20, random_state=42)

poly_multi = PolynomialFeatures(degree=2, include_bias=False)
X_train_poly2 = poly_multi.fit_transform(X_train)
X_test_poly2 = poly_multi.transform(X_test)

poly_lr = LinearRegression()
poly_lr.fit(X_train_poly2, y_train)
y_pred_poly2 = poly_lr.predict(X_test_poly2)

print(f"Cok Degiskenli Polinom R2: {r2_score(y_test, y_pred_poly2):.4f}")
print(f"Cok Degiskenli Polinom MAE: {mean_absolute_error(y_test, y_pred_poly2):.4f}")
print(f"Cok Degiskenli Polinom RMSE: {np.sqrt(mean_squared_error(y_test, y_pred_poly2)):.4f}")
