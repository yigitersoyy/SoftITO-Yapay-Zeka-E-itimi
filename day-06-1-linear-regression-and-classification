*** Wine Quality ***

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.dummy import DummyRegressor
from sklearn.linear_model import LinearRegression, Ridge, Lasso
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

SEED = 42
np.random.seed(SEED)
sns.set_theme(style="whitegrid", palette="muted")
plt.rcParams["figure.figsize"] = (10, 5)

url = "https://archive.ics.uci.edu/ml/machine-learning-databases/wine-quality/winequality-red.csv"
df = pd.read_csv(url, sep=";")
print("İlk 2 Satır:")
display(df.head(2))

print("\n--- Veri Yapısı ---")
df.info()

X_reg = df.drop(columns=["quality"])
y_reg = df["quality"]

fig, axes = plt.subplots(1, 2, figsize=(14, 5))

sns.histplot(y_reg, kde=True, ax=axes[0], discrete=True, color="#4C72B0")
axes[0].set_title("Hedef Değişken (Quality) Dağılımı")
axes[0].set_xlabel("Kalite Puanı")

corr = df.corr()
sns.heatmap(corr, cmap="coolwarm", annot=False, ax=axes[1], cbar=True)
axes[1].set_title("Öznitelik Korelasyon Isı Haritası")
plt.tight_layout()
plt.show()

X_train_r, X_test_r, y_train_r, y_test_r = train_test_split(
    X_reg, y_reg, test_size=0.20, random_state=SEED
)
print(f"Eğitim Kümesi: {X_train_r.shape[0]} satır, Test Kümesi: {X_test_r.shape[0]} satır")

def evaluate_regression(y_true, y_pred, model_name="Model"):
    mae = mean_absolute_error(y_true, y_pred)
    mse = mean_squared_error(y_true, y_pred)
    rmse = np.sqrt(mse)
    r2 = r2_score(y_true, y_pred)
    return pd.DataFrame({
        "MAE": [mae],
        "MSE": [mse],
        "RMSE": [rmse],
        "R2": [r2]
    }, index=[model_name])

dummy_reg = DummyRegressor(strategy="mean")
dummy_reg.fit(X_train_r, y_train_r)

lr = LinearRegression()
lr.fit(X_train_r, y_train_r)

reg_results = pd.concat([
    evaluate_regression(y_test_r, dummy_reg.predict(X_test_r), "Dummy Regressor"),
    evaluate_regression(y_test_r, lr.predict(X_test_r), "Linear Regression")
])
print("\n--- Model Performans Kıyaslaması ---")
display(reg_results)

fig, axes = plt.subplots(1, 2, figsize=(15, 5))

coef_series = pd.Series(lr.coef_, index=X_reg.columns).sort_values()
coef_series.plot(kind="barh", ax=axes[0], color="#55A868")
axes[0].set_title("Linear Regression Katsayı Değerleri (Ağırlıklar)")
axes[0].axvline(0, color="grey", linestyle="--")

y_pred_lr = lr.predict(X_test_r)
axes[1].scatter(y_test_r, y_pred_lr, alpha=0.4, color="#C44E52")
axes[1].plot([y_reg.min(), y_reg.max()], [y_reg.min(), y_reg.max()], "--k")
axes[1].set_xlabel("Gerçek Kalite")
axes[1].set_ylabel("Tahmin Edilen Kalite")
axes[1].set_title("Gerçek vs. Tahmin (Linear Regression)")
plt.tight_layout()
plt.show()

pipelines = {
    "Linear Regression (Scaled)": Pipeline([("scaler", StandardScaler()), ("model", LinearRegression())]),
    "Ridge (L2)": Pipeline([("scaler", StandardScaler()), ("model", Ridge(alpha=1.0, random_state=SEED))]),
    "Lasso (L1)": Pipeline([("scaler", StandardScaler()), ("model", Lasso(alpha=0.05, random_state=SEED))])
}

regularized_results = []
for name, pipe in pipelines.items():
    pipe.fit(X_train_r, y_train_r)
    preds = pipe.predict(X_test_r)
    regularized_results.append(evaluate_regression(y_test_r, preds, name))

display(pd.concat(regularized_results))

lasso_model = pipelines["Lasso (L1)"].named_steps["model"]
lasso_coefs = pd.DataFrame({
    "Feature": X_reg.columns,
    "Lasso Coefficient": lasso_model.coef_
}).sort_values(by="Lasso Coefficient", key=abs, ascending=False)

print("\n--- Lasso ile Özellik Katsayıları (L1 Seyreltme Etkisi) ---")
display(lasso_coefs)
