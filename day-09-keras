def make_windows(data, input_steps, output_steps):
    X_seq, y_seq = [], []
    for i in range(len(data) - input_steps - output_steps + 1):
        X_seq.append(data[i:i + input_steps])
        y_seq.append(data[i + input_steps:i + input_steps + output_steps])
    return np.array(X_seq), np.array(y_seq)

