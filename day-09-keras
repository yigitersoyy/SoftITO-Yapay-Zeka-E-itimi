def build_rnn_model(cell_type='LSTM', input_steps=60, features=1, output_steps=1):
    rnn_model = models.Sequential()
    if cell_type == 'LSTM':
        rnn_model.add(layers.LSTM(64, return_sequences=True, input_shape=(input_steps, features)))
        rnn_model.add(layers.LSTM(32))
    elif cell_type == 'GRU':
        rnn_model.add(layers.GRU(64, return_sequences=True, input_shape=(input_steps, features)))
        rnn_model.add(layers.GRU(32))
    rnn_model.add(layers.Dense(output_steps))
    rnn_model.compile(optimizer='adam', loss='mse', metrics=['mae'])
    return rnn_model

